{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run optimize-images",
    "dev": "vite",
    "prebuild": "npm run optimize-images",
    "build": "npm run type-check && vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "optimize-images": "node scripts/optimize-images.js",
    "qr-codes": "swift scripts/qr.swift"
  },
  "dependencies": {
    "vue": "3.5.18",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.2",
    "@types/node": "24.1.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.32.0",
    "eslint-plugin-vue": "10.4.0",
    "jiti": "2.5.1",
    "prettier": "3.6.2",
    "sass-embedded": "1.89.2",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vue-tsc": "3.0.4",
    "sharp": "0.35.4"
  }
}
