{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run optimize-images",
    "dev": "vite",
    "prebuild": "npm run optimize-images",
    "build": "npm run type-check && vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "optimize-images": "node scripts/optimize-images.js",
    "qr-codes": "swift scripts/qr.swift"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.32.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "sass-embedded": "1.105.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
